{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pre-review.invalid/pdf_structure_candidates_v1.schema.json",
  "title": "OpenDataLoader structural candidates v1 (evaluation only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "notice_id", "source_pdf_sha256", "opendataloader_raw_json_sha256", "opendataloader_canonical_json_sha256", "input_binding_schema_version", "input_binding_sha256", "source_page_count", "odl_page_count", "page_scope", "odl_page_to_source_page", "coordinate_status", "ordering_status", "evaluation_only", "non_promotable", "candidates"],
  "properties": {
    "schema_version": {"const": "pdf_structure_candidates/v1"},
    "notice_id": {"$ref": "#/$defs/trimmedString"},
    "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "opendataloader_raw_json_sha256": {"$ref": "#/$defs/sha256"},
    "opendataloader_canonical_json_sha256": {"$ref": "#/$defs/sha256"},
    "input_binding_schema_version": {"enum": ["opendataloader_artifact/v1", "legacy_opendataloader_evaluation/v1"]},
    "input_binding_sha256": {"$ref": "#/$defs/sha256"},
    "source_page_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "odl_page_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "page_scope": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "integer", "minimum": 1, "maximum": 256}},
    "odl_page_to_source_page": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/pageMapping"}},
    "coordinate_status": {"const": "odl_pdf_points_unverified"},
    "ordering_status": {"const": "odl_traversal_unverified"},
    "evaluation_only": {"const": true},
    "non_promotable": {"const": true},
    "candidates": {"type": "array", "maxItems": 25000, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trimmedString": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"},
    "pageMapping": {"type": "object", "additionalProperties": false, "required": ["odl_page", "source_page"], "properties": {"odl_page": {"type": "integer", "minimum": 1, "maximum": 256}, "source_page": {"type": "integer", "minimum": 1, "maximum": 256}}},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "tableMetadata": {"type": "object", "additionalProperties": false, "properties": {"declared_row_count": {"type": "integer", "minimum": 1, "maximum": 25000}, "declared_column_count": {"type": "integer", "minimum": 1, "maximum": 25000}, "row_number": {"type": "integer", "minimum": 1, "maximum": 25000}, "column_number": {"type": "integer", "minimum": 1, "maximum": 25000}, "row_span": {"type": "integer", "minimum": 1, "maximum": 25000}, "column_span": {"type": "integer", "minimum": 1, "maximum": 25000}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "parent_candidate_id", "odl_page", "source_page", "raw_type", "normalized_kind", "traversal_order", "traversal_path"], "properties": {"candidate_id": {"type": "string", "pattern": "^odl-[0-9a-f]{64}$"}, "parent_candidate_id": {"type": ["string", "null"], "pattern": "^odl-[0-9a-f]{64}$"}, "odl_page": {"type": "integer", "minimum": 1, "maximum": 256}, "source_page": {"type": "integer", "minimum": 1, "maximum": 256}, "raw_type": {"enum": ["heading", "paragraph", "list", "list item", "table", "table row", "table cell", "text block", "image", "caption"]}, "normalized_kind": {"enum": ["heading", "paragraph", "list", "list_item", "table", "table_row", "table_cell", "text_block", "image", "caption"]}, "traversal_order": {"type": "integer", "minimum": 1, "maximum": 25000}, "traversal_path": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "maxLength": 256}}, "bbox_odl_pdf_points_unverified": {"$ref": "#/$defs/bbox"}, "table_metadata": {"$ref": "#/$defs/tableMetadata"}}}
  }
}
