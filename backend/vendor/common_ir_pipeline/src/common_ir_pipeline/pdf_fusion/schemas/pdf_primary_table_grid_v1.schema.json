{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pre-review.invalid/pdf_primary_table_grid_v1.schema.json",
  "title": "PDF primary page-local table grid v1 (evaluation only, textless)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_only",
    "non_promotable",
    "standalone_validation_scope",
    "policy",
    "notice_id",
    "source_pdf_sha256",
    "page_scope",
    "input_artifacts",
    "tables"
  ],
  "properties": {
    "schema_version": {"const": "pdf_primary_table_grid/v1"},
    "evaluation_only": {"const": true},
    "non_promotable": {"const": true},
    "standalone_validation_scope": {"const": "internal_consistency_only"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version"],
      "properties": {
        "policy_version": {"const": "primary_page_local_table_grid/v1"}
      }
    },
    "notice_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![\\s\\S]*[\\uD800-\\uDFFF])(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "page_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 256}
    },
    "input_artifacts": {"$ref": "#/$defs/inputArtifacts"},
    "tables": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/table"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidateId": {"type": "string", "pattern": "^odl-[0-9a-f]{64}$"},
    "occurrenceId": {
      "type": "string",
      "pattern": "^occ:inspector:p[1-9][0-9]{0,2}:t(?:0|[1-9][0-9]{0,4}|[1-4][0-9]{5})$"
    },
    "inputArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_capture_schema_version",
        "native_capture_sha256",
        "render_manifest_schema_version",
        "render_manifest_sha256",
        "structure_candidates_schema_version",
        "structure_candidates_sha256",
        "reconstruction_plan_schema_version",
        "reconstruction_plan_sha256",
        "surya_layout_artifact_schema_version",
        "surya_layout_artifact_sha256"
      ],
      "properties": {
        "native_capture_schema_version": {"const": "pdf_inspector_native_capture/v1"},
        "native_capture_sha256": {"$ref": "#/$defs/sha256"},
        "render_manifest_schema_version": {"const": "pdf_render_manifest/v1"},
        "render_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "structure_candidates_schema_version": {"const": "pdf_structure_candidates/v1"},
        "structure_candidates_sha256": {"$ref": "#/$defs/sha256"},
        "reconstruction_plan_schema_version": {"const": "pdf_reconstruction_plan/v1"},
        "reconstruction_plan_sha256": {"$ref": "#/$defs/sha256"},
        "surya_layout_artifact_schema_version": {"const": "surya_layout_artifact/v1"},
        "surya_layout_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_grid_id",
        "page",
        "row_count",
        "column_count",
        "source_table_candidate_id",
        "surya_region_id",
        "rows"
      ],
      "properties": {
        "table_grid_id": {"type": "string", "pattern": "^table-grid-[0-9a-f]{64}$"},
        "page": {"type": "integer", "minimum": 1, "maximum": 256},
        "row_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "column_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "source_table_candidate_id": {"$ref": "#/$defs/candidateId"},
        "surya_region_id": {
          "type": "string",
          "pattern": "^p[0-9]{4}-table-[0-9]{4}$"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/row"},
          "contains": {
            "type": "object",
            "required": ["cells"],
            "properties": {
              "cells": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": ["occurrence_ids"],
                  "properties": {
                    "occurrence_ids": {"type": "array", "minItems": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "row_index", "cells"],
      "properties": {
        "row_id": {"type": "string", "pattern": "^table-row-[0-9a-f]{64}$"},
        "row_index": {"type": "integer", "minimum": 1, "maximum": 1000},
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/cell"}
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "row_index",
        "column_index",
        "row_span",
        "column_span",
        "source_cell_candidate_id",
        "occurrence_ids"
      ],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^table-cell-[0-9a-f]{64}$"},
        "row_index": {"type": "integer", "minimum": 1, "maximum": 1000},
        "column_index": {"type": "integer", "minimum": 1, "maximum": 1000},
        "row_span": {"const": 1},
        "column_span": {"const": 1},
        "source_cell_candidate_id": {"$ref": "#/$defs/candidateId"},
        "occurrence_ids": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/occurrenceId"}
        }
      }
    }
  }
}
