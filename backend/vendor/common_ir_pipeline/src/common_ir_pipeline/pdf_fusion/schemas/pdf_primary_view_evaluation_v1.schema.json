{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pre-review.invalid/pdf_primary_view_evaluation_v1.schema.json",
  "title": "Offline partial-Gold evaluation for PDF primary document view v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_only",
    "non_promotable",
    "standalone_validation_scope",
    "notice_id",
    "source",
    "candidate",
    "gold",
    "verdict",
    "blocking_reason_codes",
    "scope_results",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "pdf_primary_view_evaluation/v1"},
    "evaluation_only": {"const": true},
    "non_promotable": {"const": true},
    "standalone_validation_scope": {"const": "internal_consistency_only"},
    "notice_id": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^PBLN_[0-9]{15}$"
    },
    "source": {"$ref": "#/$defs/source"},
    "candidate": {"$ref": "#/$defs/candidateReference"},
    "gold": {"$ref": "#/$defs/goldReference"},
    "verdict": {
      "enum": [
        "passed",
        "failed",
        "not_evaluable_gold_pending",
        "not_evaluable_gold_untrusted",
        "blocked_scope_mismatch"
      ]
    },
    "blocking_reason_codes": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "notice_id_mismatch",
          "source_pdf_mismatch",
          "native_capture_mismatch",
          "gold_page_scope_not_covered",
          "gold_occurrence_not_covered"
        ]
      }
    },
    "scope_results": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/scopeResult"}
    },
    "metrics": {"$ref": "#/$defs/metrics"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "page": {"type": "integer", "minimum": 1, "maximum": 256},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"
    },
    "boundedString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![\\s\\S]*[\\uD800-\\uDFFF])(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"
    },
    "occurrence": {
      "type": "string",
      "pattern": "^occ:inspector:p(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-6]):t(?:0|[1-9][0-9]{0,4}|[1-4][0-9]{5})$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_pdf_sha256", "native_capture_sha256"],
      "properties": {
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "native_capture_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "canonical_sha256"],
      "properties": {
        "schema_version": {"const": "pdf_primary_document_view/v1"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "goldReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "canonical_sha256", "quality_status"],
      "properties": {
        "schema_version": {"const": "pdf_primary_structure_gold/v1"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "quality_status": {
          "enum": [
            "evaluable",
            "not_evaluable_gold_pending",
            "not_evaluable_untrusted_confirmation"
          ]
        }
      }
    },
    "scopeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "physical_page",
        "verdict",
        "failure_codes",
        "group_results",
        "hard_negative_results"
      ],
      "properties": {
        "scope_id": {"$ref": "#/$defs/identifier"},
        "physical_page": {"$ref": "#/$defs/page"},
        "verdict": {"enum": ["passed", "failed"]},
        "failure_codes": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["ordered_group_failed", "hard_negative_violated"]}
        },
        "group_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/groupResult"}
        },
        "hard_negative_results": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/hardNegativeResult"}
        }
      }
    },
    "groupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "expected_kind",
        "status",
        "failure_codes",
        "candidate_leaf_ids",
        "expected_occurrence_ids",
        "observed_reviewed_occurrence_ids",
        "boundary_results",
        "unscored_attached_occurrence_ids"
      ],
      "properties": {
        "group_id": {"$ref": "#/$defs/identifier"},
        "expected_kind": {"const": "paragraph"},
        "status": {"enum": ["passed", "failed"]},
        "failure_codes": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "missing_occurrence",
              "under_merged",
              "reviewed_scope_over_merge",
              "kind_mismatch",
              "occurrence_order_mismatch",
              "boundary_mismatch"
            ]
          }
        },
        "candidate_leaf_ids": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/boundedString"}
        },
        "expected_occurrence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/occurrence"}
        },
        "observed_reviewed_occurrence_ids": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/occurrence"}
        },
        "boundary_results": {
          "type": "array",
          "maxItems": 4095,
          "items": {"$ref": "#/$defs/boundaryResult"}
        },
        "unscored_attached_occurrence_ids": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/occurrence"}
        }
      }
    },
    "boundaryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_occurrence_id",
        "right_occurrence_id",
        "expected_join_class",
        "observed_join_class",
        "status"
      ],
      "properties": {
        "left_occurrence_id": {"$ref": "#/$defs/occurrence"},
        "right_occurrence_id": {"$ref": "#/$defs/occurrence"},
        "expected_join_class": {"enum": ["intra_word_wrap", "inter_token_space"]},
        "observed_join_class": {
          "oneOf": [
            {"enum": ["intra_word_wrap", "inter_token_space"]},
            {"type": "null"}
          ]
        },
        "status": {
          "enum": ["matched", "mismatched", "missing", "unscored_scope_outside"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["matched", "mismatched"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "observed_join_class": {
                "enum": ["intra_word_wrap", "inter_token_space"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["missing", "unscored_scope_outside"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {"observed_join_class": {"type": "null"}}
          }
        }
      ]
    },
    "hardNegativeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "occurrence_id",
        "target_group_id",
        "status",
        "violating_leaf_id"
      ],
      "properties": {
        "kind": {"const": "forbidden_same_leaf"},
        "occurrence_id": {"$ref": "#/$defs/occurrence"},
        "target_group_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["satisfied", "violated"]},
        "violating_leaf_id": {
          "oneOf": [
            {"$ref": "#/$defs/boundedString"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "satisfied"}},
            "required": ["status"]
          },
          "then": {
            "properties": {"violating_leaf_id": {"type": "null"}}
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "violated"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "violating_leaf_id": {"$ref": "#/$defs/boundedString"}
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_scope_count",
        "evaluated_scope_count",
        "passed_scope_count",
        "failed_scope_count",
        "ordered_group_count",
        "matched_group_count",
        "failed_group_count",
        "hard_negative_count",
        "hard_negative_violation_count",
        "unscored_attachment_count"
      ],
      "properties": {
        "reviewed_scope_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "evaluated_scope_count": {"type": "integer", "minimum": 0},
        "passed_scope_count": {"type": "integer", "minimum": 0},
        "failed_scope_count": {"type": "integer", "minimum": 0},
        "ordered_group_count": {"type": "integer", "minimum": 0},
        "matched_group_count": {"type": "integer", "minimum": 0},
        "failed_group_count": {"type": "integer", "minimum": 0},
        "hard_negative_count": {"type": "integer", "minimum": 0},
        "hard_negative_violation_count": {"type": "integer", "minimum": 0},
        "unscored_attachment_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
