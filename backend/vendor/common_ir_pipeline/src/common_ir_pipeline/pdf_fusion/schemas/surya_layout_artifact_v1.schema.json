{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pre-review.invalid/surya_layout_artifact_v1.schema.json",
  "title": "Pre-review Surya layout artifact v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "logical_compute_key", "source_sha256", "page_count", "render_manifest_schema_version", "render_manifest_sha256", "producer", "requested_pages", "pages"],
  "properties": {
    "schema_version": {"const": "surya_layout_artifact/v1"}, "logical_compute_key": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "page_count": {"type": "integer", "minimum": 1}, "render_manifest_schema_version": {"const": "pdf_render_manifest/v1"}, "render_manifest_sha256": {"$ref": "#/$defs/sha256"}, "producer": {"$ref": "#/$defs/producer"}, "requested_pages": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "integer", "minimum": 1}}, "pages": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "workerImageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "trimmedString": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"}, "number": {"type": "number"}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/number"}}, "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/number"}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["coordinate_manifest_schema_version", "coordinate_manifest_sha256", "source_sha256", "page", "page_image_sha256"], "properties": {"coordinate_manifest_schema_version": {"const": "pdf_coordinate_manifest/v1"}, "coordinate_manifest_sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "page": {"type": "integer", "minimum": 1}, "page_image_sha256": {"$ref": "#/$defs/sha256"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["engine_id", "engine_version", "model_id", "model_revision", "model_weights_sha256", "pipeline_revision", "config_sha256", "worker_image_digest"], "properties": {"engine_id": {"const": "surya"}, "engine_version": {"$ref": "#/$defs/trimmedString"}, "model_id": {"$ref": "#/$defs/trimmedString"}, "model_revision": {"$ref": "#/$defs/trimmedString"}, "model_weights_sha256": {"$ref": "#/$defs/sha256"}, "pipeline_revision": {"$ref": "#/$defs/trimmedString"}, "config_sha256": {"$ref": "#/$defs/sha256"}, "worker_image_digest": {"$ref": "#/$defs/workerImageDigest"}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["region_id", "label", "bbox_px", "polygon_px", "confidence", "reading_order"], "properties": {"region_id": {"type": "string", "minLength": 1}, "label": {"enum": ["caption", "footnote", "equation", "list_group", "page_header", "page_footer", "picture", "section_header", "table", "text", "figure", "code", "form", "table_of_contents", "chemical_block", "diagram", "bibliography", "blank_page"]}, "bbox_px": {"$ref": "#/$defs/bbox"}, "polygon_px": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point"}}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "reading_order": {"type": "integer", "minimum": 0}}},
    "page": {"type": "object", "additionalProperties": false, "required": ["page", "sidecar_binding", "pixel_width", "pixel_height", "rendered_page_px", "regions"], "properties": {"page": {"type": "integer", "minimum": 1}, "sidecar_binding": {"$ref": "#/$defs/binding"}, "pixel_width": {"type": "integer", "minimum": 1}, "pixel_height": {"type": "integer", "minimum": 1}, "rendered_page_px": {"$ref": "#/$defs/bbox"}, "regions": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/region"}}}}
  }
}
