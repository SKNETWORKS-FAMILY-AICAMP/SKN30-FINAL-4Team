{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://common-ir.local/schemas/pdf_primary_document_view_v1.schema.json",
  "title": "PDF Primary Document View v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_only",
    "non_promotable",
    "standalone_validation_scope",
    "notice_id",
    "source",
    "page_scope",
    "policy",
    "leaves",
    "relations",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "pdf_primary_document_view/v1"},
    "evaluation_only": {"const": true},
    "non_promotable": {"const": true},
    "standalone_validation_scope": {"const": "internal_consistency_only"},
    "notice_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "source": {"$ref": "#/$defs/source"},
    "page_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 256}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version"],
      "properties": {
        "policy_version": {"const": "native_continuity_intra_word/v1"}
      }
    },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500000,
      "items": {"$ref": "#/$defs/leaf"}
    },
    "relations": {"type": "array", "maxItems": 0},
    "metrics": {"$ref": "#/$defs/metrics"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "occurrence_id": {
      "type": "string",
      "pattern": "^occ:inspector:p(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-6]):t(?:0|[1-9][0-9]{0,4}|[1-4][0-9]{5})$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_pdf_sha256",
        "native_capture",
        "reconstruction_plan"
      ],
      "properties": {
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "native_capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "canonical_sha256", "extractor_version"],
          "properties": {
            "schema_version": {"const": "pdf_inspector_native_capture/v1"},
            "canonical_sha256": {"$ref": "#/$defs/sha256"},
            "extractor_version": {"const": "1.17.0"}
          }
        },
        "reconstruction_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "canonical_sha256"],
          "properties": {
            "schema_version": {"const": "pdf_reconstruction_plan/v1"},
            "canonical_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_occurrence_id", "right_occurrence_id", "join_class"],
      "properties": {
        "left_occurrence_id": {"$ref": "#/$defs/occurrence_id"},
        "right_occurrence_id": {"$ref": "#/$defs/occurrence_id"},
        "join_class": {"const": "intra_word_wrap"}
      }
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaf_id",
        "kind",
        "page",
        "occurrence_ids",
        "boundaries",
        "placement_method",
        "reason_codes",
        "structural_evidence_occurrence_ids"
      ],
      "properties": {
        "leaf_id": {"type": "string", "pattern": "^leaf-[0-9a-f]{64}$"},
        "kind": {"enum": ["unclassified_text", "paragraph"]},
        "page": {"type": "integer", "minimum": 1, "maximum": 256},
        "occurrence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/occurrence_id"}
        },
        "boundaries": {
          "type": "array",
          "maxItems": 1,
          "items": {"$ref": "#/$defs/boundary"}
        },
        "placement_method": {"enum": ["atomic_fallback", "native_continuity"]},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reason_code"}
        },
        "structural_evidence_occurrence_ids": {"type": "array", "maxItems": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "unclassified_text"}}},
          "then": {
            "properties": {
              "occurrence_ids": {"minItems": 1, "maxItems": 1},
              "boundaries": {"maxItems": 0},
              "placement_method": {"const": "atomic_fallback"},
              "reason_codes": {"const": ["authoritative_atomic_fallback"]}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "paragraph"}}},
          "then": {
            "properties": {
              "occurrence_ids": {"minItems": 2, "maxItems": 2},
              "boundaries": {"minItems": 1, "maxItems": 1},
              "placement_method": {"const": "native_continuity"}
            }
          }
        }
      ]
    },
    "bounded_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500000
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative_occurrence_count",
        "placed_occurrence_count",
        "leaf_count",
        "atomic_fallback_leaf_count",
        "paragraph_leaf_count",
        "merged_boundary_count",
        "missing_occurrence_count",
        "duplicate_occurrence_count",
        "ownership_gate_status"
      ],
      "properties": {
        "authoritative_occurrence_count": {"$ref": "#/$defs/bounded_count"},
        "placed_occurrence_count": {"$ref": "#/$defs/bounded_count"},
        "leaf_count": {"$ref": "#/$defs/bounded_count"},
        "atomic_fallback_leaf_count": {"$ref": "#/$defs/bounded_count"},
        "paragraph_leaf_count": {"$ref": "#/$defs/bounded_count"},
        "merged_boundary_count": {"$ref": "#/$defs/bounded_count"},
        "missing_occurrence_count": {"const": 0},
        "duplicate_occurrence_count": {"const": 0},
        "ownership_gate_status": {"const": "passed"}
      }
    }
  }
}
