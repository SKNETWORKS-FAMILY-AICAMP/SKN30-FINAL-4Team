{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pre-review.invalid/legacy_opendataloader_evaluation_v1.schema.json",
  "title": "Legacy OpenDataLoader evaluation envelope v1 (non-promotable)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_only", "non_promotable", "coordinate_status", "notice_id", "source_pdf_sha256", "raw_json_sha256", "canonical_json_sha256", "source_page_count", "odl_page_count", "page_scope", "odl_page_to_source_page", "parser_name_claim", "parser_version_claim", "parser_claim_status", "config_status", "ocr_claim_status", "binding_basis"],
  "properties": {
    "schema_version": {"const": "legacy_opendataloader_evaluation/v1"},
    "evaluation_only": {"const": true},
    "non_promotable": {"const": true},
    "coordinate_status": {"const": "odl_pdf_points_unverified"},
    "notice_id": {"$ref": "#/$defs/trimmedString"},
    "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "raw_json_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_json_sha256": {"$ref": "#/$defs/sha256"},
    "source_page_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "odl_page_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "page_scope": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "integer", "minimum": 1, "maximum": 256}},
    "odl_page_to_source_page": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/pageMapping"}},
    "parser_name_claim": {"const": "opendataloader-pdf"},
    "parser_version_claim": {"const": "2.5.7"},
    "parser_claim_status": {"const": "documented_not_machine_bound"},
    "config_status": {"const": "unavailable"},
    "ocr_claim_status": {"const": "disabled_documented_not_machine_bound"},
    "binding_basis": {"const": "curated_manifest_source_hash/v1"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trimmedString": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[\\s\\S]+$"},
    "pageMapping": {"type": "object", "additionalProperties": false, "required": ["odl_page", "source_page"], "properties": {"odl_page": {"type": "integer", "minimum": 1, "maximum": 256}, "source_page": {"type": "integer", "minimum": 1, "maximum": 256}}}
  }
}
