{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pre-review.invalid/pdf_primary_corpus_split_v1.schema.json",
  "title": "Immutable PDF primary corpus split v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_only",
    "non_promotable",
    "standalone_validation_scope",
    "selection_boundary_commit",
    "source_baseline",
    "policy",
    "cases",
    "sealed_case"
  ],
  "properties": {
    "schema_version": {"const": "pdf_primary_corpus_split/v1"},
    "evaluation_only": {"const": true},
    "non_promotable": {"const": true},
    "standalone_validation_scope": {"const": "internal_consistency_only"},
    "selection_boundary_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_baseline": {"$ref": "#/$defs/sourceBaseline"},
    "policy": {"$ref": "#/$defs/policy"},
    "cases": {
      "type": "array",
      "$comment": "prefixItems fixes canonical role order; runtime additionally enforces global case/source identity uniqueness",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/tuningCase"},
        {"$ref": "#/$defs/knownRegressionCase"},
        {"$ref": "#/$defs/heldOutCase"},
        {"$ref": "#/$defs/heldOutCase"},
        {"$ref": "#/$defs/negativeControlCase"}
      ],
      "items": false
    },
    "sealed_case": {"$ref": "#/$defs/sealedCase"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"
    },
    "noticeId": {
      "type": "string",
      "pattern": "^PBLN_[0-9]{15}$"
    },
    "pageScope": {
      "type": "array",
      "$comment": "runtime requires strictly increasing physical-page order",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 256}
    },
    "checkKinds": {
      "type": "array",
      "$comment": "runtime requires the declared canonical check-kind order",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "paragraph",
          "heading_relation",
          "table_grid",
          "table_continuation",
          "legacy_structural_regression",
          "table_grid_negative",
          "table_continuation_negative"
        ]
      }
    },
    "sourceBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "corpus_id", "canonical_sha256"],
      "properties": {
        "schema_version": {"const": "pdf_fusion_corpus_baseline/v1"},
        "corpus_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"
        },
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_cardinality",
        "current_supported_slices"
      ],
      "properties": {
        "role_cardinality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tuning",
            "known_regression",
            "held_out",
            "sealed_blind",
            "negative_control"
          ],
          "properties": {
            "tuning": {"const": 1},
            "known_regression": {"const": 1},
            "held_out": {"const": 2},
            "sealed_blind": {"const": 1},
            "negative_control": {"const": 1}
          }
        },
        "current_supported_slices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"const": "two_occurrence_paragraph"},
            {"const": "numbered_single_line_heading_to_next_paragraph"},
            {"const": "unit_span_table_grid"},
            {"const": "adjacent_page_between_rows_continuation"}
          ],
          "items": false
        }
      }
    },
    "baseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "role",
        "notice_id",
        "source_pdf_sha256",
        "planned_page_scope",
        "full_native_capture_required",
        "scope_claim",
        "state_at_selection",
        "required_check_kinds"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "role": {
          "enum": ["tuning", "known_regression", "held_out", "negative_control"]
        },
        "notice_id": {"$ref": "#/$defs/noticeId"},
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "planned_page_scope": {"$ref": "#/$defs/pageScope"},
        "full_native_capture_required": {"const": true},
        "scope_claim": {"const": "reviewed_regions_only"},
        "state_at_selection": {
          "enum": ["gold_ready", "gold_pending", "legacy_migration_required"]
        },
        "required_check_kinds": {"$ref": "#/$defs/checkKinds"}
      }
    },
    "tuningCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "properties": {
            "role": {"const": "tuning"},
            "state_at_selection": {"const": "gold_ready"},
            "required_check_kinds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": ["paragraph", "heading_relation", "table_grid", "table_continuation"]
              }
            }
          }
        }
      ]
    },
    "knownRegressionCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "properties": {
            "role": {"const": "known_regression"},
            "state_at_selection": {"enum": ["gold_ready", "legacy_migration_required"]},
            "required_check_kinds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": ["paragraph", "heading_relation", "table_grid", "table_continuation", "legacy_structural_regression"]
              },
              "contains": {"const": "legacy_structural_regression"}
            }
          }
        }
      ]
    },
    "heldOutCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "properties": {
            "role": {"const": "held_out"},
            "state_at_selection": {"enum": ["gold_ready", "gold_pending"]},
            "required_check_kinds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": ["paragraph", "heading_relation", "table_grid", "table_continuation"]
              }
            }
          }
        }
      ]
    },
    "negativeControlCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "properties": {
            "role": {"const": "negative_control"},
            "state_at_selection": {"const": "gold_pending"},
            "required_check_kinds": {
              "const": ["table_grid_negative", "table_continuation_negative"]
            }
          }
        }
      ]
    },
    "sealedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "role", "state_at_selection", "commitment"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "role": {"const": "sealed_blind"},
        "state_at_selection": {"const": "sealed_unrevealed"},
        "commitment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": {"const": "sha256_salted_canonical_json_v1"},
            "digest": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  }
}
