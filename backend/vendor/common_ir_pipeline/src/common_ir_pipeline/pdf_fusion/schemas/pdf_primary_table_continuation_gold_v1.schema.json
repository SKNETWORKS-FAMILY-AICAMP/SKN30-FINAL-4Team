{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pre-review.invalid/pdf_primary_table_continuation_gold_v1.schema.json",
  "title": "Textless partial PDF table-continuation Gold v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_only",
    "non_promotable",
    "standalone_validation_scope",
    "notice_id",
    "source",
    "page_scope",
    "reviewed_continuations"
  ],
  "properties": {
    "schema_version": {"const": "pdf_primary_table_continuation_gold/v1"},
    "evaluation_only": {"const": true},
    "non_promotable": {"const": true},
    "standalone_validation_scope": {"const": "internal_consistency_only"},
    "notice_id": {"$ref": "#/$defs/noticeId"},
    "source": {"$ref": "#/$defs/source"},
    "page_scope": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/page"}
    },
    "reviewed_continuations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/continuation"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "noticeId": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^PBLN_[0-9]{15}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"
    },
    "page": {"type": "integer", "minimum": 1, "maximum": 256},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_pdf_sha256",
        "canonical_page_renders",
        "native_capture",
        "base_table_grid_gold"
      ],
      "properties": {
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_page_renders": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/pageRender"}
        },
        "native_capture": {"$ref": "#/$defs/nativeCapture"},
        "base_table_grid_gold": {"$ref": "#/$defs/baseGold"}
      }
    },
    "pageRender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_page", "canonical_render_sha256"],
      "properties": {
        "physical_page": {"$ref": "#/$defs/page"},
        "canonical_render_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nativeCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "canonical_sha256", "extractor_version"],
      "properties": {
        "schema_version": {"const": "pdf_inspector_native_capture/v1"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "extractor_version": {"const": "1.17.0"}
      }
    },
    "baseGold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "canonical_sha256"],
      "properties": {
        "schema_version": {"const": "pdf_primary_table_grid_gold/v1"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "columnMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_column_id", "successor_column_id"],
      "properties": {
        "predecessor_column_id": {"$ref": "#/$defs/identifier"},
        "successor_column_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuation_id",
        "predecessor_scope_id",
        "successor_scope_id",
        "relation_kind",
        "column_mapping",
        "review_status",
        "reviewer_ref",
        "confirmed_at"
      ],
      "properties": {
        "continuation_id": {"$ref": "#/$defs/identifier"},
        "predecessor_scope_id": {"$ref": "#/$defs/identifier"},
        "successor_scope_id": {"$ref": "#/$defs/identifier"},
        "relation_kind": {"const": "between_rows"},
        "column_mapping": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/columnMapping"}
        },
        "review_status": {
          "enum": ["pending_human_confirmation", "human_confirmed"]
        },
        "reviewer_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 10,
              "maxLength": 129,
              "pattern": "^reviewer:[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
            },
            {"type": "null"}
          ]
        },
        "confirmed_at": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 20,
              "maxLength": 20,
              "format": "date-time",
              "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
            },
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"review_status": {"const": "pending_human_confirmation"}},
            "required": ["review_status"]
          },
          "then": {
            "properties": {
              "reviewer_ref": {"type": "null"},
              "confirmed_at": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "reviewer_ref": {
                "type": "string",
                "minLength": 10,
                "maxLength": 129,
                "pattern": "^reviewer:[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
              },
              "confirmed_at": {
                "type": "string",
                "minLength": 20,
                "maxLength": 20,
                "format": "date-time",
                "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              }
            }
          }
        }
      ]
    }
  }
}
