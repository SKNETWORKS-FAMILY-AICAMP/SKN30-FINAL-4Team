FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache

WORKDIR /app/backend

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

COPY vendor ./vendor
COPY requirements.txt requirements.report-worker.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.report-worker.txt

COPY . ./

RUN useradd --system --uid 10001 --home-dir /tmp --shell /usr/sbin/nologin report-worker
USER 10001:10001

CMD ["python", "-m", "worker.report_main"]
