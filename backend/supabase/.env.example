# ============================================================================
# Supabase 환경 설정
# Date: 2026-08-31
#
# self-hosted 또는 cloud Supabase의 DB·Storage 접속 설정.
# .env로 복사한 뒤 실제 값을 작성한다.
# ============================================================================

# ============================================================================
# EC2 self-hosted 배포 경로
# ============================================================================
# 공식 Supabase Docker Compose 설치 디렉터리.
# 이 디렉터리의 .env에는 JWT/DB/SMTP 비밀값을 별도로 둔다.
SUPABASE_COMPOSE_DIR=/srv/pre-review/supabase

# EC2 호스트의 PostgreSQL 영속 데이터 디렉터리(EBS 볼륨 권장).
# 없으면 prepare_selfhosted.sh가 생성한다. / 경로는 절대 지정하지 않는다.
SUPABASE_DB_DATA_DIR=/data/pre-review/postgres

# 파일 기반 Storage를 쓸 때 사용할 선택적 호스트 경로.
# S3/Object Storage 배포는 Storage 데이터를 별도로 관리한다.
SUPABASE_STORAGE_DATA_DIR=/data/pre-review/storage

# 벡터 검색은 별도 컨테이너가 아닌 이 Supabase PostgreSQL의 pgvector를 사용한다.
# 실제 데이터는 SUPABASE_DB_DATA_DIR 아래에 함께 영속된다.
# 임베딩 모델/차원은 검색 설계가 확정될 때까지 비워 둔다.
VECTOR_DB_ENGINE=pgvector
VECTOR_DB_SCHEMA=retrieval
# VECTOR_EMBEDDING_MODEL=
# VECTOR_EMBEDDING_DIMENSIONS=

# GPU worker가 Edge Function 콜백에 사용할 사설 Tailnet URL.
SUPABASE_INTERNAL_URL=http://supabase-ec2.tailnet-name.ts.net:8000

# ============================================================================
# 런타임 애플리케이션/worker 설정(실제 값은 .env에만 작성)
# ============================================================================
SUPABASE_URL=http://127.0.0.1:8000

# Supabase Anonymous Key (public, safe for client-side use)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_KEY=your-anon-key

# Supabase Service Role Key (SECRET - backend use only)
# Never expose this in client-side code
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database connection (for direct backend access if needed)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres?sslmode=disable

# Storage bucket names
STORAGE_BUCKET_KB=existing-kb
STORAGE_BUCKET_WORKSPACE=request-temp
STORAGE_BUCKET_REPORTS=analysis-reports

# Analysis configuration
# Session expiry time in minutes (default: 120 = 2 hours)
ANALYSIS_SESSION_EXPIRY_MINUTES=120

# Result retention days (default: 90)
RESULT_RETENTION_DAYS=90

# Workspace cleanup check interval in minutes (default: 15)
WORKSPACE_CLEANUP_INTERVAL_MINUTES=15

# ============================================================================
# Self-hosted Supabase Only
# ============================================================================

# PostgREST API configuration
POSTGREST_URL=http://localhost:3000

# GoTrue (Auth) API configuration
GOTRUEURL=http://localhost:9999

# Postgres configuration for direct connections
# This is optional if using Supabase proxy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable

# Worker 작업 요청 및 완료 콜백. GPU worker가 Tailscale로 콜백 URL에 닿아야 한다.
# Worker 설정에 PostgreSQL URL을 넣지 않는다.
ANALYSIS_WORKER_DISPATCH_URL=http://gpu-worker.tailnet-name.ts.net:8080/jobs
ANALYSIS_WORKER_DISPATCH_TOKEN=replace-with-secret
ANALYSIS_WORKER_INGEST_PROFILE_URL=http://supabase-ec2.tailnet-name.ts.net:8000/functions/v1/edge-analysis-run-ingest-request-profile
ANALYSIS_WORKER_CALLBACK_TOKEN=replace-with-different-secret

# ============================================================================
# Optional: Advanced Configuration
# ============================================================================

# Enable detailed logging
DEBUG=false

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Connection pool size
DB_POOL_SIZE=10
