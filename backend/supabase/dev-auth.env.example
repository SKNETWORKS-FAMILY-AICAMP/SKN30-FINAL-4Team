# 로컬 Supabase Auth 개발 계정 전용 예시입니다.
#
# 이 파일을 Git 추적 밖의 기본 경로로 복사하고 실제 값을 채운 뒤 mode 0600으로
# 제한합니다. 파일을 source할 필요가 없으며 Git에 추가하거나 공유하지 않습니다.
#
#   cp --update=none backend/supabase/dev-auth.env.example .runtime/pre-review-dev-auth.env
#   chmod 600 .runtime/pre-review-dev-auth.env
#
# 실행 시 비민감 이중 opt-in도 별도로 제공해야 합니다.
#
#   cd backend
#   PREREVIEW_ENVIRONMENT=development \
#   PREREVIEW_DEV_AUTH_BOOTSTRAP_ENABLED=true \
#     uv run python scripts/bootstrap_local_auth_user.py

# 실제 사람이 사용하는 주소가 아닌 예약된 테스트 도메인만 허용됩니다.
PREREVIEW_DEV_AUTH_EMAIL=

# 12자 이상, UTF-8 인코딩 기준 최대 72바이트입니다. CLI 인자, shell history,
# 문서, 채팅에 값을 넣지 않습니다.
PREREVIEW_DEV_AUTH_PASSWORD=

# 이 one-shot은 최소 권한의 일반 사용자만 생성합니다.
PREREVIEW_DEV_AUTH_ROLE=user
