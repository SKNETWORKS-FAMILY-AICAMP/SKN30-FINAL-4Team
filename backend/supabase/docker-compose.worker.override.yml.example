# 이 파일을 self-hosted Supabase Compose 디렉터리에
# docker-compose.pre-review-worker.yml 이름으로 복사한다.
# 값은 해당 Compose 디렉터리의 .env에서 읽는다.
services:
  functions:
    environment:
      ANALYSIS_WORKER_DISPATCH_URL: ${ANALYSIS_WORKER_DISPATCH_URL}
      ANALYSIS_WORKER_DISPATCH_TOKEN: ${ANALYSIS_WORKER_DISPATCH_TOKEN}
      ANALYSIS_WORKER_INGEST_PROFILE_URL: ${ANALYSIS_WORKER_INGEST_PROFILE_URL}
      ANALYSIS_WORKER_CALLBACK_TOKEN: ${ANALYSIS_WORKER_CALLBACK_TOKEN}
      CONVERSATION_WORKER_DISPATCH_URL: ${CONVERSATION_WORKER_DISPATCH_URL}
      CONVERSATION_WORKER_DISPATCH_TOKEN: ${CONVERSATION_WORKER_DISPATCH_TOKEN}
