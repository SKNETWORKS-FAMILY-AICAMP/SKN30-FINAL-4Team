{
  "schema_version": "prereview.runpod-surya-worker/v1",
  "storage_scopes": [
    {
      "method": "GET",
      "origin": "https://storage-host.example.invalid",
      "endpoint_path_template": "/storage/v1/object/sign/{bucket}/{object_key}",
      "bucket": "request-temp",
      "object_key_prefix": "accelerator/input/"
    },
    {
      "method": "PUT",
      "origin": "https://storage-host.example.invalid",
      "endpoint_path_template": "/storage/v1/object/upload/sign/{bucket}/{object_key}",
      "bucket": "request-temp",
      "object_key_prefix": "accelerator/surya-layout/"
    }
  ],
  "dispatch_policy": {
    "max_ttl_seconds": 1800,
    "max_execution_timeout_seconds": 180,
    "max_page_count": 20,
    "max_total_input_bytes": 268435456,
    "max_total_rendered_pixels": 300000000,
    "max_capability_bytes": 67108864,
    "allowed_mime_types": [
      "application/json",
      "image/png"
    ]
  },
  "producer": {
    "engine_id": "surya",
    "engine_version": "0.22.1",
    "model_id": "datalab-to/surya-ocr-2",
