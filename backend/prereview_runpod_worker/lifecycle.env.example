# Copy this template only to a protected operator-controlled location; do not
# commit the filled copy.  Values are injected for one `start`/`run` command,
# written as mode-0600 fixed files under /run/prereview-surya, then unset by
# the supervisor before it launches tailscaled, vLLM, or the API.
#
# The two values are independent.  The API bearer is required when its fixed
# /run file is absent.  The Tailscale key is required only for a fresh or
# NeedsLogin state.  A completely fresh Pod normally needs both; an authenticated
# state migration or same-Pod restart may need only the missing value.
#
# In a RunPod Template, map these names to separate RunPod Secret references;
# never commit or paste the real values into this example.
PREREVIEW_RUNPOD_BOOTSTRAP_API_BEARER_TOKEN=
PREREVIEW_RUNPOD_BOOTSTRAP_TAILSCALE_AUTH_KEY=

# Non-secret required node identity. They are verified against tailscale
# status JSON; DNSName must be the exact tailnet value (including any trailing
# dot returned by your installed CLI).
PREREVIEW_RUNPOD_TAILSCALE_HOSTNAME=
PREREVIEW_RUNPOD_TAILSCALE_DNS_NAME=

# Required whenever /run/config.json or its protected config.sha256 marker is
# absent.  Repeating the same reviewed source/digest is allowed.  The source
# must not be config.example.json (or an identical placeholder).
PREREVIEW_RUNPOD_CONFIG_SOURCE_FILE=
PREREVIEW_RUNPOD_CONFIG_SHA256=
