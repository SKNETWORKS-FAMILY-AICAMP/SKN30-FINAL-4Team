# FastAPI는 브라우저의 유일한 공개 업무 API입니다.
# 같은 호스트의 로컬 Supabase와 저장소 루트 OpenAI 설정을 사용할 때는 값을
# 복사하지 말고 scripts/prepare_local_backend_env.py로 이 파일을 생성할 수 있습니다.
# 생성기는 기존 backend/.env를 덮어쓰지 않으며 비밀값을 출력하지 않습니다.
# 복사해 실행하는 환경은 실제 Supabase 인증을 사용하도록 안전한 기본값을 둡니다.
# true는 네트워크에 노출하지 않는 OpenAPI/계약 검증 전용입니다.
PREREVIEW_OFFLINE_MODE=false
# Docker provenance is calculated from the complete Docker COPY context during
# image build. It has no operator-supplied environment or build-arg setting.
PREREVIEW_API_BIND_ADDRESS=127.0.0.1
PREREVIEW_API_PORT=8001
PREREVIEW_UPLOAD_MAX_BYTES=52428800
PREREVIEW_HTTP_MAX_BODY_BYTES=53477376
# multipart parsing 이후 파일 bytes 조립·Storage 전송을 동시에 수행할 요청 수입니다.
# 요청당 최대 약 100 MiB의 순간 메모리를 고려해 API memory budget에 맞춰 조정합니다.
PREREVIEW_UPLOAD_CONCURRENCY=2
PREREVIEW_API_LIMIT_CONCURRENCY=32
# 분석 upload 예약과 chat create/retry가 공유하는 PostgreSQL worker backlog 상한입니다.
# API replica 전체에서 같은 1~10000 정수를 사용해야 하며, 기본 25는 보수적인
# fail-closed 값입니다. 가득 찬 경우 새 작업은 503이고 같은 Idempotency-Key의
# 정확한 재전송은 기존 작업을 반환합니다.
PREREVIEW_GLOBAL_QUEUE_MAX=25
# 분석 이력과 대화 이력의 opaque cursor를 HMAC으로 서명하는 서버 전용 비밀값입니다.
# online API에서는 비어 있으면 cursor pagination이 503으로 fail-closed합니다. 충분히 긴
# 임의값을 사용하고 API 인스턴스 간/재기동 간에 유지합니다. 값을 바꾸면 기존 cursor는 무효화됩니다.
PREREVIEW_CURSOR_SIGNING_SECRET=

# 쉼표로 구분한 정확한 프론트엔드 origin. Cookie 상태 변경 요청은 이 목록이
# 비어 있으면 fail-closed(403)합니다.
# 운영 기본 예시입니다. 로컬 HTTP 설정은 prepare_local_backend_env.py로 생성하거나
# 운영 가이드의 명시적 개발 예외를 사용합니다.
PREREVIEW_AUTH_ALLOWED_ORIGINS=https://app.example.com
PREREVIEW_AUTH_COOKIE_SECURE=true
PREREVIEW_AUTH_COOKIE_SAMESITE=lax
PREREVIEW_AUTH_COOKIE_DOMAIN=
PREREVIEW_AUTH_REFRESH_COOKIE_MAX_AGE=2592000
PREREVIEW_AUTH_PASSWORD_RESET_REDIRECT_TO=https://app.example.com/reset-password

# Self-hosted Supabase 내부 주소와 서버 전용 자격증명입니다. 실제 값은 커밋하지
# 않습니다. ANON key도 브라우저에 주지 않고 FastAPI가 Auth 검증에만 씁니다.
SUPABASE_URL=http://host.docker.internal:8000
SUPABASE_ANON_KEY=
# Self-hosted 배포의 기존 JWT형 service-role key 이름도 지원합니다. 둘 중 실제
# 배포가 제공하는 하나만 설정합니다.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI와 같은 서버에서 실행하는 worker만 사용하는 내부 PostgreSQL DSN.
# SUPABASE_DB_URL도 호환되지만 새 배포에서는 DATABASE_URL을 권장합니다.
DATABASE_URL=
SUPABASE_DB_URL=

# LLM과 retrieval embedding 제공자는 독립적으로 선택합니다. 현재 embedding은
# OpenAI만 지원하며, LLM을 vLLM으로 바꿔도 Existing vector provenance는 유지됩니다.
# 빈 값은 OpenAI로 동작해 기존 배포와 호환됩니다. 키를 출력하거나 커밋하지 마세요.
PREREVIEW_LLM_PROVIDER=openai
PREREVIEW_EMBEDDING_PROVIDER=openai

# OpenAI LLM/embedding 설정. PREREVIEW_LLM_PROVIDER=openai일 때 LLM에 사용합니다.
OPENAI_API_KEY=
# 모든 LLM 단계의 fallback OpenAI 모델 ID입니다. 단계별 모델이 비어 있으면 이 값을 씁니다.
OPENAI_LLM_MODEL=gpt-5.6-luna
# Request Profile 구조화만 더 높은 정확도의 모델로 분리할 수 있습니다.
OPENAI_REQUEST_PROFILE_MODEL=gpt-5.6-terra
# 필요할 때만 CPL·FIT·SIM·결과 근거 채팅도 fallback과 다른 모델로 분리합니다.
OPENAI_CPL_MODEL=
OPENAI_FIT_MODEL=
OPENAI_SIM_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_REPAIRS=2

# Experimental OpenAI 호환 vLLM endpoint. external release E2E는 실제 runtime-bound
# manifest 계약 전까지 vLLM을 명시적으로 거부합니다. inline/offline 계약 검증만 지원합니다.
# PREREVIEW_LLM_PROVIDER=vllm일 때 BASE_URL/API_KEY/LLM_MODEL이 모두 필요합니다.
# BASE_URL은 HTTPS만 허용합니다. 로컬 개발 예외로 localhost/127.0.0.0/8/::1만 HTTP를 허용합니다.
# VLLM_LLM_MODEL은 모든 단계의 fallback이며, 단계별 값이 비어 있으면 fallback을 씁니다.
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_LLM_MODEL=
VLLM_REQUEST_PROFILE_MODEL=
VLLM_CPL_MODEL=
VLLM_FIT_MODEL=
VLLM_SIM_MODEL=
VLLM_CHAT_MODEL=
VLLM_TIMEOUT_SECONDS=120
VLLM_MAX_REPAIRS=2
# Chat Completions `max_tokens`와 streaming response body의 bounded safety caps.
VLLM_MAX_OUTPUT_TOKENS=16384
VLLM_MAX_RESPONSE_BYTES=1048576

# PostgreSQL polling worker: Redis/RQ와 HTTP callback은 사용하지 않습니다.
PREREVIEW_WORKER_HEARTBEAT_SECONDS=30
PREREVIEW_WORKER_LEASE_SECONDS=120
PREREVIEW_WORKER_IDLE_POLL_SECONDS=1
PREREVIEW_WORKER_TOP_K=5
# true(기본)는 활성 Existing KB/retrieval 결과가 없으면 분석을 재시도/실패시킵니다.
# false는 빈 KB를 정상 완료 `KB_EMPTY`로 표시합니다. request 축이 0개인
# `RETRIEVAL_INPUT_MISSING`과 zero vector는 어떤 설정에서도 허용하지 않습니다.
PREREVIEW_EXISTING_KB_REQUIRED=true
PREREVIEW_WORKER_STORAGE_TIMEOUT_SECONDS=30
PREREVIEW_WORKER_DATABASE_CONNECT_TIMEOUT_SECONDS=10
PREREVIEW_WORKER_PARSE_TIMEOUT_SECONDS=120
# Docker 이미지 안의 경로. parser subprocess에만 LD_PRELOAD로 전달됩니다.
PREREVIEW_FREETYPE_LIB=/usr/lib/x86_64-linux-gnu/libfreetype.so.6

# 분석 결과에 답하는 별도 Chat polling worker입니다. API는 질문과
# generating 메시지만 원자 등록하고 OpenAI 호출은 이 프로세스가 수행합니다.
PREREVIEW_CHAT_WORKER_HEARTBEAT_SECONDS=30
PREREVIEW_CHAT_WORKER_LEASE_SECONDS=120
PREREVIEW_CHAT_WORKER_IDLE_POLL_SECONDS=1
PREREVIEW_CHAT_DATABASE_CONNECT_TIMEOUT_SECONDS=10

# ML은 백엔드에 import하지 않고 외부 root/serving 디렉터리에서
# subprocess로 격리 실행합니다. 호스트에서 worker를 직접 실행할 때는
# 절대경로를 사용합니다. 정확한 serving.zip 검증과 model1 weight 배치는
# worker 운영 가이드를 따릅니다.
PREREVIEW_ML_ROOT=
PREREVIEW_MODEL1_SERVING_DIR=
# 별도 ML Python 환경이 필요할 때만 지정합니다. 비워 두면 worker Python을 씁니다.
PREREVIEW_ML_PYTHON_EXECUTABLE=
PREREVIEW_ML_TIMEOUT_SECONDS=180
# 호스트에서 직접 실행한 worker는 모델별 unavailable 결과를 기본으로 남긴다.
# Docker Compose는 필수 immutable runtime을 모두 받은 뒤에만 이 값을 true로 고정한다.
PREREVIEW_STRICT_ML_RUNTIME_PREFLIGHT=false

# Docker Compose 분석 worker 전용. 추적된 ml/ source 및 Model 2/3 artifact는
# 전용 image의 /app/ml에 들어가며, 이 값은 검증된 외부 Model 1 runtime
# directory를 /opt/prereview/model1로 read-only mount합니다. 빈 값으로
# Compose를 실행하면 worker는 fail-closed합니다. API/chat-worker에는 이 mount와
# ML dependency가 전혀 없습니다. Linux amd64 host의 절대 경로를 넣습니다.
# 예: /absolute/path/to/SKN30-FINAL-4Team/.runtime/model1-serving/model1
PREREVIEW_MODEL1_SERVING_HOST_DIR=
# Model 1 준비 스크립트는 의도적으로 mode 0700을 사용합니다. non-root worker가
# mount를 읽을 수 있도록 이 디렉터리의 숫자 owner를 넣습니다.
# 예: stat -c '%u:%g' <runtime-dir>. 둘 중 하나라도 비면 Compose는 fail-closed합니다.
PREREVIEW_MODEL1_RUNTIME_UID=
PREREVIEW_MODEL1_RUNTIME_GID=
