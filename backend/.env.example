# FastAPI는 브라우저의 유일한 공개 업무 API입니다.
# 같은 호스트의 로컬 Supabase와 저장소 루트 OpenAI 설정을 사용할 때는 값을
# 복사하지 말고 scripts/prepare_local_backend_env.py로 이 파일을 생성할 수 있습니다.
# 생성기는 기존 backend/.env를 덮어쓰지 않으며 비밀값을 출력하지 않습니다.
# 복사해 실행하는 환경은 실제 Supabase 인증을 사용하도록 안전한 기본값을 둡니다.
# true는 네트워크에 노출하지 않는 OpenAPI/계약 검증 전용입니다.
PREREVIEW_OFFLINE_MODE=false
PREREVIEW_API_BIND_ADDRESS=127.0.0.1
PREREVIEW_API_PORT=8001
PREREVIEW_UPLOAD_MAX_BYTES=52428800

# 쉼표로 구분한 정확한 프론트엔드 origin. Cookie 상태 변경 요청은 이 목록이
# 비어 있으면 fail-closed(403)합니다.
# 운영 기본 예시입니다. 로컬 HTTP 설정은 prepare_local_backend_env.py로 생성하거나
# 운영 가이드의 명시적 개발 예외를 사용합니다.
PREREVIEW_AUTH_ALLOWED_ORIGINS=https://app.example.com
PREREVIEW_AUTH_COOKIE_SECURE=true
PREREVIEW_AUTH_COOKIE_SAMESITE=lax
PREREVIEW_AUTH_COOKIE_DOMAIN=
PREREVIEW_AUTH_REFRESH_COOKIE_MAX_AGE=2592000
PREREVIEW_AUTH_PASSWORD_RESET_REDIRECT_TO=https://app.example.com/reset-password

# Self-hosted Supabase 내부 주소와 서버 전용 자격증명입니다. 실제 값은 커밋하지
# 않습니다. ANON key도 브라우저에 주지 않고 FastAPI가 Auth 검증에만 씁니다.
SUPABASE_URL=http://host.docker.internal:8000
SUPABASE_ANON_KEY=
# Self-hosted 배포의 기존 JWT형 service-role key 이름도 지원합니다. 둘 중 실제
# 배포가 제공하는 하나만 설정합니다.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI와 같은 서버에서 실행하는 worker만 사용하는 내부 PostgreSQL DSN.
# SUPABASE_DB_URL도 호환되지만 새 배포에서는 DATABASE_URL을 권장합니다.
DATABASE_URL=
SUPABASE_DB_URL=

# 분석/채팅 모델은 코드에 고정하지 않습니다. 키를 출력하거나 커밋하지 마세요.
OPENAI_API_KEY=
# Request Profile·FIT·SIM 구조화에 공통으로 쓰는 OpenAI 모델 ID입니다.
OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_REPAIRS=1

# PostgreSQL polling worker: Redis/RQ와 HTTP callback은 사용하지 않습니다.
PREREVIEW_WORKER_HEARTBEAT_SECONDS=30
PREREVIEW_WORKER_LEASE_SECONDS=120
PREREVIEW_WORKER_IDLE_POLL_SECONDS=1
PREREVIEW_WORKER_TOP_K=5
PREREVIEW_WORKER_STORAGE_TIMEOUT_SECONDS=30
PREREVIEW_WORKER_DATABASE_CONNECT_TIMEOUT_SECONDS=10
PREREVIEW_WORKER_PARSE_TIMEOUT_SECONDS=120
# Docker 이미지 안의 경로. parser subprocess에만 LD_PRELOAD로 전달됩니다.
PREREVIEW_FREETYPE_LIB=/usr/lib/x86_64-linux-gnu/libfreetype.so.6

# 분석 결과에 답하는 별도 Chat polling worker입니다. API는 질문과
# generating 메시지만 원자 등록하고 OpenAI 호출은 이 프로세스가 수행합니다.
PREREVIEW_CHAT_WORKER_HEARTBEAT_SECONDS=30
PREREVIEW_CHAT_WORKER_LEASE_SECONDS=120
PREREVIEW_CHAT_WORKER_IDLE_POLL_SECONDS=1
PREREVIEW_CHAT_DATABASE_CONNECT_TIMEOUT_SECONDS=10
