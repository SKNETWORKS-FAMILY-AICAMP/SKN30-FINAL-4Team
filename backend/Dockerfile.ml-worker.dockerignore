# Security boundary for the repository-root ML worker build context.
# Keep the repository-root .dockerignore and the Dockerfile-specific copy
# byte-for-byte identical: BuildKit uses this file, while the classic builder
# only reads the context-root file.
*

!backend/
!backend/Dockerfile.ml-worker
!backend/vendor/
!backend/vendor/common_ir_pipeline/
!backend/vendor/common_ir_pipeline/pyproject.toml
!backend/vendor/common_ir_pipeline/src/
!backend/vendor/common_ir_pipeline/src/**
!backend/vendor/portable_existing_request_profiles_20260831/
!backend/vendor/portable_existing_request_profiles_20260831/pyproject.toml
!backend/vendor/portable_existing_request_profiles_20260831/common_ir_schema/
!backend/vendor/portable_existing_request_profiles_20260831/common_ir_schema/*.py
!backend/vendor/portable_existing_request_profiles_20260831/semantic_structuring/
!backend/vendor/portable_existing_request_profiles_20260831/semantic_structuring/*.py
!backend/app/
!backend/app/**
!backend/worker/
!backend/worker/**
!backend/requirements.txt
!backend/scripts/
!backend/scripts/classify_existing_model1.py

!ml/
!ml/serving/
!ml/serving/requirements.txt
!ml/serving/requirements.runtime.txt
!ml/serving/shared/
!ml/serving/shared/preconsultation_adapter.py
!ml/serving/model2/
!ml/serving/model2/predict.py
!ml/serving/model2/feature_builder.py
!ml/serving/model2/preprocessing.py
!ml/serving/model2/masking.py
!ml/serving/model2/proximity.py
!ml/serving/model2/router.py
!ml/serving/model2/cohort_reference.parquet
!ml/serving/model3/
!ml/serving/model3/score.py
!ml/serving/model3/inference.py
!ml/serving/model3/design_features_v3.parquet
!ml/models/
!ml/models/model2_canonical/
!ml/models/model2_canonical/model2_p3_bundle.joblib
!ml/data/
!ml/data/processed/
!ml/data/processed/business_taxonomy.parquet
!ml/pipelines/
!ml/pipelines/shared/
!ml/pipelines/shared/*.py
!ml/pipelines/model1/
!ml/pipelines/model1/dl07_m1_apply.py
!ml/pipelines/model1/m01_support_type.py
!ml/pipelines/model2/
!ml/pipelines/model2/*.py
!ml/pipelines/model3/
!ml/pipelines/model3/*.py
!ml/experiments/
!ml/experiments/model2/
!ml/experiments/model2/core/
!ml/experiments/model2/core/*.py

# Re-exclude local hygiene and credential files after the directory
# allowlists above. Docker ignore matching is last-rule-wins, so these rules
# must remain below every negated directory rule.
.git
.git/**
**/.git
**/.git/**
.pytest_cache
.pytest_cache/**
**/.pytest_cache
**/.pytest_cache/**
__pycache__
__pycache__/**
**/__pycache__
**/__pycache__/**
*.py[cod]
**/*.py[cod]
.venv
.venv/**
**/.venv
**/.venv/**
venv
venv/**
**/venv
**/venv/**
*.egg-info
*.egg-info/**
**/*.egg-info
**/*.egg-info/**
.env
.env.*
**/.env
**/.env.*
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
id_rsa
id_rsa.*
**/id_rsa
**/id_rsa.*
handover
handover/**
**/handover
**/handover/**

# Retired pre-rebuild worker modules depend on deleted compatibility APIs and
# are not reachable from worker.main. Keep them out of both worker builders.
backend/worker/analysis.py
backend/worker/dispatcher.py
backend/worker/execution_log.py
backend/worker/jobs.py
backend/worker/kb_ingest.py
backend/worker/kb_store.py
backend/worker/persistence.py
backend/worker/queue.py
backend/worker/report_pdf.py
