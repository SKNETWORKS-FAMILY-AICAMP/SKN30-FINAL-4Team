DATABASE_URL=postgresql+psycopg://postgres:replace-me@127.0.0.1:5432/sims
DATABASE_CONNECT_TIMEOUT_SECONDS=3
# At least 32 random bytes; do not commit the real value.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Required by the internal Bizinfo synchronization command.
# BIZINFO_API_KEY=replace-me
BIZINFO_API_URL=https://www.bizinfo.go.kr/uss/rss/bizinfoApi.do
BIZINFO_TIMEOUT_SECONDS=30

# Required for Retrieval; CPL semantic review degrades safely when it is absent.
# OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_PROFILE_NAME=bizinfo-summary
EMBEDDING_PROFILE_VERSION=1
EMBEDDING_PREPROCESSING_VERSION=detail-ref-v1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=100
CPL_MODEL_PROFILE=gpt-4o-mini
CPL_PROMPT_VERSION=cpl-semantic-v0.1
CPL_RULESET_VERSION=cpl-alpha-v0.1
CPL_LLM_TIMEOUT_SECONDS=30
FIT_RULESET_VERSION=fit-v0.1
FIT_PROMPT_VERSION=fit-v0.1
FIT_MODEL_PROFILE=gpt-4o-mini
FIT_SCORING_PATH=backend/config/fit_scoring.json
FIT_PROMPT_PATH=backend/config/prompts/fit-v0.1.txt
