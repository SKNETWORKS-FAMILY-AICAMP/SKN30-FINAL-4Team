# scripts/e2e_up.sh 가 띄우는 로컬 개발용 컨테이너에 맞춘 값이다.
# 직접 설치한 PostgreSQL 을 쓴다면 포트와 계정을 바꾼다.
DATABASE_URL=
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# [Supabase PostgreSQL 사용 시] 위 DATABASE_URL 을 아래 중 하나로 바꾼다.
# 1) Connection Pooler (IPv4 호환 권장 / Session 모드: 5432, Transaction 모드: 6543)
#    Transaction 모드는 prepared statement 를 지원하지 않아 Session 모드를 쓴다.
# DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require
# 2) Direct Connection (직접 연결)
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# 연결만으로는 끝나지 않는다. app/db/schema.sql 을 적용해야 /health/ready 가 200 이 된다.

# At least 32 random bytes; do not commit the real value.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Email password reset (disabled until all five mail fields and URL are set).
# Gmail: enable 2-step verification, use an app password, NOT account password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Frontend reset screen; HTTPS required except loopback local development.
# Example: http://localhost:3000/reset-password
PASSWORD_RESET_URL=
# Exact HTTP(S) origins as a JSON array; use [] to disable cross-origin access.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Required by the internal announcement synchronization command.
# 공공데이터포털(data.go.kr)에서 발급받은 "디코딩 키"를 넣는다.
# 인코딩 키를 넣으면 HTTP 클라이언트가 % 를 다시 인코딩해 인증에 실패한다.
# BIZINFO_API_KEY=replace-me
BIZINFO_API_URL=https://apis.data.go.kr/1421000/bizinfo/pblancBsnsService
BIZINFO_TIMEOUT_SECONDS=30

# Required for Retrieval; CPL semantic review degrades safely when it is absent.
# OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_PROFILE_NAME=bizinfo-summary
EMBEDDING_PROFILE_VERSION=1
EMBEDDING_PREPROCESSING_VERSION=detail-ref-v1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=100
CPL_MODEL_PROFILE=gpt-4o-mini
CPL_PROMPT_VERSION=cpl-semantic-v0.9
CPL_RULESET_VERSION=cpl-alpha-v0.3
CPL_LLM_TIMEOUT_SECONDS=30
CPL_PROMPT_PATH=backend/config/prompts/cpl-v0.9.txt
FIT_RULESET_VERSION=fit-v0.3
FIT_PROMPT_VERSION=fit-v0.5
FIT_MODEL_PROFILE=gpt-4o-mini
FIT_SCORING_PATH=backend/config/fit_scoring_v0.2.json
FIT_PROMPT_PATH=backend/config/prompts/fit-v0.5.txt
SIM_RULESET_VERSION=sim-v0.2
SIM_PROMPT_VERSION=sim-v0.3
SIM_MODEL_PROFILE=gpt-4o-mini
SIM_SCORING_PATH=backend/config/sim_scoring.json
SIM_PROMPT_PATH=backend/config/prompts/sim-v0.3.txt

# ==========================================
# 자체 운영 모델 (재설계 초안 v0.2 §11) — LLM·임베딩 모두 자체 vLLM 사용
# 실제 RunPod 주소·키·배포 모델 ID 는 아직 확보되지 않았다.
# 주소가 정해지면 GET {VLLM_BASE_URL}/models 로 실제 served id 를 확인해 넣는다.
# ==========================================
# OpenAI 호환 base URL. 끝의 /v1 까지 포함한다. 예: https://<pod>.proxy.runpod.net/v1
VLLM_BASE_URL=
VLLM_API_KEY=
# vllm serve 에 넘긴 값과 정확히 같아야 한다.
VLLM_LLM_MODEL=
# 같은 vLLM 인스턴스가 서빙하는 임베딩 모델. 차원은 여기 적지 않는다.
# 실제 차원은 연결 시 probe_dimension() 1 회로 확인해 sims.embedding_model 행에 기록한다.
VLLM_EMBEDDING_MODEL=
VLLM_TIMEOUT_SECONDS=60
# 의미 보완 재검 예산. 초안 §9.2 의 기본 1 회.
VLLM_MAX_REPAIRS=1
