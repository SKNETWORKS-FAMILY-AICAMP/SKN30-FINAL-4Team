# Do not commit a real key. Load this file with: set -a; . ./.env; set +a
OPENAI_API_KEY=
# Optional. The runner defaults to gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna
# Existing/Request retrieval. 2048 is an API input-array limit, not a token cap.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_MAX_INPUT_TOKENS=8192
OPENAI_EMBEDDING_BATCH_SIZE=100
