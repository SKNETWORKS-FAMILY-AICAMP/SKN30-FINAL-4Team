# Copy this example to Caddyfile.local and replace the example domain,
# Tailnet address, and static root before installing it on a server.
app.example.com {
	encode zstd gzip

	# Preserve /api/v1/... while forwarding through the Tailnet.
	handle /api/* {
		reverse_proxy 100.64.0.10:8001
	}

	# Do not publish the design-reference HTML copied from public/.
	handle /html/* {
		respond 404
	}

	# React/Vite single-page application.
	handle {
		root * /srv/app

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		route {
			try_files {path} /index.html
			header /index.html Cache-Control "public, max-age=0, must-revalidate"
		}

		file_server
	}
}
