{
  "document_version": "v1.0",
  "document_date": "2026-08-31",
  "document_status": "AS_IS_OBSERVED",
  "description": "현재 백엔드가 실제로 내보내는 응답을 관측해 정리한 명세다. 업무 API 는 성공·실패 모두 공통 4필드를 쓴다. 토큰·ID·시각 등 본문 값은 예시이며 고정값이 아니다.",
  "base_path_note": "모든 업무 API 는 /api/v1 아래에 있고, 헬스체크 2개만 /health 아래에 있다.",
  "authentication": {
    "scheme": "Bearer",
    "header": "Authorization: Bearer <access_token>",
    "public_endpoints": [
      "POST /api/v1/auth/login",
      "POST /api/v1/auth/password-reset/request",
      "POST /api/v1/auth/password-reset/confirm",
      "GET /health/live",
      "GET /health/ready"
    ],
    "notes": [
      "401 응답에는 WWW-Authenticate: Bearer 헤더가 붙는다.",
      "비밀번호가 바뀌면 그 이전에 발급된 토큰은 거부된다."
    ]
  },
  "response_format": {
    "summary": "업무 API 는 성공·실패 모두 공통 4필드로 응답한다.",
    "fields": [
      {
        "field": "code",
        "rule": "성공은 SUCCESS, 분석 접수는 ACCEPTED, 실패는 원인 코드"
      },
      {
        "field": "message",
        "rule": "사람이 읽는 안내. 문자열로 분기하지 않는다"
      },
      {
        "field": "data",
        "rule": "실제 결과. 결과 데이터가 없는 성공은 null"
      },
      {
        "field": "errors",
        "rule": "검증 오류의 필드별 정보. 그 외에는 빈 배열"
      }
    ],
    "http_status_note": "HTTP 상태는 상태줄에 있으므로 본문에 넣지 않는다. response.status 로 읽는다.",
    "exceptions": [
      {
        "case": "PDF 다운로드 성공",
        "shape": "application/pdf 바이너리. 실패는 공통 4필드"
      },
      {
        "case": "헬스체크 2개",
        "shape": "{\"status\": ...}. 모니터링용 별도 계약이라 통일 대상이 아니다"
      }
    ]
  },
  "front_error_handling": [
    {
      "match": "401",
      "action": "로그인 실패 또는 재로그인 안내"
    },
    {
      "match": "429",
      "action": "Retry-After 만큼 기다린 뒤 재시도 안내"
    },
    {
      "match": "그 외 4xx",
      "action": "message 표시. 422 면 errors 배열을 해당 입력란에도 표시"
    },
    {
      "match": "5xx",
      "action": "처리 불가 안내. 재시도 여부는 작업 성격에 따라 결정"
    }
  ],
  "analysis_status_values": [
    {
      "display": "분석 중",
      "internal": [
        "UPLOADED",
        "PARSING",
        "CHECKING",
        "RETRIEVING",
        "REPORTING"
      ],
      "caution": "아직 시작하지 않은 건도 여기 포함된다"
    },
    {
      "display": "분석 완료",
      "internal": [
        "COMPLETED"
      ],
      "caution": null
    },
    {
      "display": "분석 실패",
      "internal": [
        "FAILED"
      ],
      "caution": "재분석 API 가 없어 새로 업로드해야 한다"
    }
  ],
  "call_sequence": [
    "1. 로그인 → access_token 확보",
    "2. 문서 업로드(200) → case_id 확보",
    "3. 분석 시작(202)",
    "4. 상태 조회를 반복. '분석 완료' 면 결과 조회, '분석 실패' 면 failure_message 표시 후 재업로드 안내",
    "5. 분석 결과 조회 → 화면 표시",
    "6. report_download_url 이 있으면 인증 헤더를 붙여 PDF 다운로드",
    "7. 보고서가 준비된 건에서 질문 전송·대화 이력 조회"
  ],
  "apis": [
